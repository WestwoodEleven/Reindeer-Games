rules_version = '2';
// Reindeer Games: Firestore security rules.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Phone sign-ins have no email, so read it safely.
    function email() { return request.auth.token.get('email', '').lower(); }
    // Phone sign-ins carry a verified number like +19495551234.
    function phone() { return request.auth.token.get('phone_number', ''); }
    function isOrg() {
      return signedIn() && (
        (email() != ''
          && request.auth.token.get('email_verified', false) == true
          && exists(/databases/$(database)/documents/organizers/$(email())))
        || (phone() != ''
          && exists(/databases/$(database)/documents/organizers/$(phone()))));
    }
    function isMember() {
      return isOrg() || (signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)));
    }
    function myHome() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.homeId;
    }
    function shortText(v, n) { return v is string && v.size() > 0 && v.size() <= n; }

    // The join password lives here. Only organizers can read it; the rules compare against it.
    function gamePassword() {
      return get(/databases/$(database)/documents/secrets/game).data.password;
    }
    function rightPassword(code) {
      return code is string && code.size() >= 4 && code == gamePassword();
    }
    // The member record this same request is writing (used by self-join batches).
    function newMember() {
      return getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    match /organizers/{e} {
      allow read: if signedIn() && (email() == e || phone() == e);
      allow write: if false;            // add organizers in the Firebase console
    }

    match /secrets/{doc} {
      allow read, write: if isOrg();
    }

    // public/join = { enabled } tells the site whether to offer the password option.
    match /public/{doc} {
      allow read: if signedIn();
      allow write: if isOrg();
    }

    // members/{uid} = { homeId, ... }. The organizer writes these when approving,
    // or a person creates their own by entering the join password.
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOrg());
      allow create: if isOrg() || (
        signedIn() && request.auth.uid == uid
        && rightPassword(request.resource.data.code)
        && request.resource.data.homeId is string
        && (exists(/databases/$(database)/documents/homes/$(request.resource.data.homeId))
            || existsAfter(/databases/$(database)/documents/homes/$(request.resource.data.homeId))));
      allow update: if isOrg();
      // anyone can remove their own membership (Delete my account)
      allow delete: if isOrg() || (signedIn() && request.auth.uid == uid);
    }

    // houseIndex/{houseNumber} = { family, homeId }. Lets someone signed in check
    // whether their house is already playing (one number at a time, no listing).
    match /houseIndex/{n} {
      allow get: if signedIn();
      allow list, update, delete: if isOrg();
      allow create: if isOrg() || (
        signedIn() && rightPassword(newMember().code)
        && request.resource.data.homeId == newMember().homeId);
    }

    match /config/{doc} {
      allow read: if isMember();
      allow write: if isOrg();
    }

    match /homes/{id} {
      allow read: if isMember();
      allow create: if isOrg() || (
        signedIn() && request.resource.data.ownerId == request.auth.uid
        && shortText(request.resource.data.family, 60)
        && shortText(request.resource.data.number, 10)
        && rightPassword(newMember().code)
        && newMember().homeId == id);
      allow update, delete: if isOrg();
    }

    // Join requests: each person can create or edit only their own pending request.
    match /joins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOrg());
      allow create, update: if isOrg() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && shortText(request.resource.data.family, 60)
        && shortText(request.resource.data.number, 10)
        && (resource == null || resource.data.status != 'approved'));
      allow delete: if isOrg() || (signedIn() && request.auth.uid == uid);
    }

    match /steals/{id} {
      allow read: if isMember();
      allow create: if isOrg() || (
        isMember() && request.resource.data.by == request.auth.uid
        && (request.resource.data.from == myHome() || request.resource.data.to == myHome()));
      allow update: if isOrg()
        || (isMember() && resource.data.by == request.auth.uid)
        // the thief fills in a steal the other family reported as "unknown"
        || (isMember() && resource.data.to == null
            && request.resource.data.to == myHome()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to', 'at']));
      allow delete: if isOrg() || (isMember() && resource.data.by == request.auth.uid);
    }

    // Feed posts: participants post and react; authors and organizers delete.
    match /posts/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow update: if isOrg() || (isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
      allow delete: if isOrg() || (isMember() && resource.data.by == request.auth.uid);
    }

    // Replies to feed posts. Authors, the post's author and organizers can delete.
    match /replies/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && shortText(request.resource.data.text, 500)
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow delete: if isOrg() || (isMember() && (resource.data.by == request.auth.uid
        || get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.by == request.auth.uid));
    }

    // Reports: any participant can file one; only organizers can read or act on them.
    match /reports/{id} {
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update, delete: if isOrg();
    }

    // Each person's private block list.
    match /blocks/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // devices/{pushToken} = { uid, homeId, ... }. Each phone registers itself for
    // alerts. Only the alert-sending function (which bypasses rules) reads them.
    match /devices/{token} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    match /media/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == request.auth.uid;
      allow delete: if isOrg() || (isMember() && resource.data.by == request.auth.uid);
    }
  }
}
