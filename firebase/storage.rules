rules_version = '2';
// Reindeer Games: Storage security rules.
// Paste into Firebase console > Storage > Rules, then Publish.
service firebase.storage {
  match /b/{bucket}/o {
    function isOrg() {
      return request.auth != null
        && request.auth.token.get('email', '') != ''
        && request.auth.token.get('email_verified', false) == true
        && firestore.exists(/databases/(default)/documents/organizers/$(request.auth.token.get('email', '').lower()))
        || request.auth != null
        && request.auth.token.get('phone_number', '') != ''
        && firestore.exists(/databases/(default)/documents/organizers/$(request.auth.token.get('phone_number', '')));
    }
    function isMember() {
      return isOrg() || (request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid)));
    }
    // Family profile photos: anyone playing can see them; only that family (or an organizer) can change them.
    match /profiles/{homeId}/{file} {
      allow read: if isMember();
      allow create: if isMember()
        && (isOrg() || firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.homeId == homeId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOrg() || (isMember()
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.homeId == homeId);
    }

    match /media/{season}/{file} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if isOrg() || (isMember() && resource.metadata.by == request.auth.uid);
    }
  }
}
