rules_version = '2';
// Reindeer Games: Storage security rules.
// Paste into Firebase console > Storage > Rules, then Publish.
service firebase.storage {
  match /b/{bucket}/o {
    function isOrg() {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/organizers/$(request.auth.token.email.lower()));
    }
    function isMember() {
      return isOrg() || (request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid)));
    }
    match /media/{season}/{file} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*')
        && request.resource.metadata.by == request.auth.uid;
      allow delete: if isOrg() || (isMember() && resource.metadata.by == request.auth.uid);
    }
  }
}
